<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE web-app PUBLIC "-//Sun Microsystems, Inc.//DTD Web Application 2.3//EN" "http://java.sun.com/dtd/web-app_2_3.dtd">
<web-app>
  <display-name>Acme Legacy</display-name>

  <listener>
    <listener-class>com.acme.legacy.web.AppListener</listener-class>
  </listener>

  <filter>
    <filter-name>encoding</filter-name>
    <filter-class>org.apache.catalina.filters.SetCharacterEncodingFilter</filter-class>
  </filter>
  <filter>
    <filter-name>auth</filter-name>
    <filter-class>com.acme.legacy.web.AuthFilter</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>encoding</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>
  <filter-mapping>
    <filter-name>auth</filter-name>
    <url-pattern>/api/*</url-pattern>
  </filter-mapping>

  <servlet>
    <servlet-name>users</servlet-name>
    <servlet-class>com.acme.legacy.web.UserServlet</servlet-class>
    <load-on-startup>1</load-on-startup>
  </servlet>
  <servlet>
    <servlet-name>orders</servlet-name>
    <servlet-class>com.acme.legacy.web.OrderServlet</servlet-class>
  </servlet>
  <servlet>
    <servlet-name>health</servlet-name>
    <servlet-class>com.acme.legacy.web.HealthServlet</servlet-class>
  </servlet>
  <servlet>
    <servlet-name>struts</servlet-name>
    <servlet-class>org.apache.struts.action.ActionServlet</servlet-class>
  </servlet>
  <servlet>
    <servlet-name>about</servlet-name>
    <jsp-file>/WEB-INF/jsp/about.jsp</jsp-file>
  </servlet>

  <servlet-mapping>
    <servlet-name>users</servlet-name>
    <url-pattern>/api/users/*</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>orders</servlet-name>
    <url-pattern>/api/orders</url-pattern>
    <url-pattern>/api/orders/*</url-pattern>
  </servlet-mapping>
  <servlet-mapping><servlet-name>health</servlet-name><url-pattern>/health</url-pattern></servlet-mapping>
  <servlet-mapping><servlet-name>struts</servlet-name><url-pattern>*.do</url-pattern></servlet-mapping>
  <servlet-mapping><servlet-name>about</servlet-name><url-pattern>/about</url-pattern></servlet-mapping>
</web-app>
